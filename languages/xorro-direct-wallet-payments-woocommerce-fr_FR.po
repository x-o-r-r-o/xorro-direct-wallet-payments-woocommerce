#. translators: %s: host
#: includes/class-xdwp-selftest.php:349
#, php-format
msgid ""
"%s is rate-limiting this site. Payments will still be found, just more "
"slowly — an API key raises the limit."
msgstr ""
"%s limite ce site. Les paiements seront toujours trouvés, un peu plus "
"lentement — une clé API augmente la limite."

#. translators: 1: host, 2: HTTP status code
#: includes/class-xdwp-selftest.php:361
#, php-format
msgid ""
"%1$s answered with HTTP %2$d. Payments in this coin may not be confirmed "
"automatically."
msgstr ""
"%1$s répondu par HTTP %2$d. Les paiements dans cette pièce ne peuvent pas "
"être confirmés automatiquement."

#. translators: %s: host
#: includes/class-xdwp-selftest.php:374
#, php-format
msgid "%s answered normally, so incoming payments can be seen."
msgstr ""
"%s a répondu normalement, de sorte que les paiements entrants peuvent être "
