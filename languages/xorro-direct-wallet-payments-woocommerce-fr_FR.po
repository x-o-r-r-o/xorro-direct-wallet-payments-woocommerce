#. translators: 1: amount received, 2: amount still due
#: includes/class-xdwp-verifier.php:339
#, php-format
msgid "Received %1$s, which is short — %2$s still due"
msgstr "Reçu %1$s, qui est court — %2$s encore dus"

#. translators: 1: amount, 2: symbol, 3: txid
#: includes/class-xdwp-verifier.php:430
#, php-format
msgid ""
"A transfer of %1$s %2$s (txid: %3$s) arrived that could belong to this order"
