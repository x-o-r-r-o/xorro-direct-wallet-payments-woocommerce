#: includes/class-xdwp-selftest.php:324
#, php-format
msgid ""
"Could not reach %1$s: %2$s. Payments in this coin will not be confirmed "
"automatically."
msgstr ""
"Impossible d'atteindre %1$s : %2$s. Les paiements dans cette pièce ne seront"
