msgid "Only send on the network shown. Your order is confirmed automatically once the payment arrives."
msgstr "Chỉ gửi trên mạng hiển thị. Lệnh của anh được xác nhận tự động khi có tiền."

#. translators: %s: order number
#: templates/emails/plain/xdwp-payment-reminder.php:21
#: templates/emails/xdwp-payment-reminder.php:30
#, php-format
msgid "Your order #%s is still waiting for payment, and the payment window closes soon. If you have already sent it, you can ignore this email — the order updates as soon as the transfer arrives."
msgstr "Thứ tự #%s vẫn đang chờ thanh toán, và cửa sổ thanh toán sẽ đóng sớm. Nếu bạn đã gửi rồi, bạn có thể bỏ qua email này — cập nhật hàng đợi khi chuyển khoản đến."

#: templates/emails/xdwp-payment-details.php:65
msgid "Open payment page (QR code)"
msgstr "Mở trang công cụ (QR code)"

#. translators: %s: coin name
#: templates/payment.php:26
#, php-format
msgid "Pay with %s"
msgstr "Trả bằng %s"

#: templates/payment.php:31
msgid "Payment confirmed. Thank you!"
msgstr "Đã xác nhận. Cảm ơn!"

#: templates/payment.php:33
msgid "The payment window closed before the full amount arrived. We have received part of your payment — please contact us and we will complete or refund your order. Do not send more."
msgstr "Cửa sổ thanh toán đóng trước khi số tiền đầy đủ đến. Chúng tôi đã nhận được một phần tiền công của ông — xin hãy liên lạc với chúng tôi và chúng tôi sẽ hoàn tất hoặc hoàn lại mệnh lệnh của ông. Đừng gửi thêm nữa."

#: templates/payment.php:36
msgid "The payment window closed, so the amount shown is out of date. You can get a new amount at today's rate — your order is kept."
msgstr "Cửa sổ thanh toán đóng lại, nên số tiền hiện ra hết hạn. Bạn có thể nhận được một số tiền mới với tốc độ ngày hôm nay - đặt hàng của bạn được giữ lại."

#: templates/payment.php:38
msgid "Get a new amount"
msgstr "Lấy một số tiền mới"

#: templates/payment.php:42
msgid "Payment window expired. Please place a new order."
msgstr "Cửa sổ thanh toán hết hạn. Xin hãy đặt một trật tự mới."

#. translators: 1: amount received, 2: symbol, 3: full amount due, 4: remaining amount
#: templates/payment.php:51
#, php-format
msgid "We received %1$s %2$s of %3$s %2$s. Please send the remaining %4$s %2$s to the same address to complete your order."
msgstr ""

#: templates/payment.php:62
msgid "Send exactly the amount below (network fees are extra)."
msgstr "Gửi chính xác số tiền dưới đây (tiền làm việc trực tuyến thêm)."

#: templates/payment.php:63
msgid "Use the matching network shown for this coin."
msgstr "Dùng mạng tương ứng hiển thị cho đồng xu này."

#: templates/payment.php:64
msgid "Wait for automatic confirmation — this page updates itself."
msgstr "Hãy chờ đợi sự xác nhận tự động — trang này tự cập nhật."

