#: includes/admin/views/settings-page.php:64
msgid "Quoted crypto amount is valid for this duration. Default: 60."
msgstr "Cytowana kwota szyfrowania jest ważna przez ten czas. Domyślnie: 60."

#: includes/admin/views/settings-page.php:68
msgid "Order status after payment"
