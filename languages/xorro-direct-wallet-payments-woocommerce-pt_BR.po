msgstr "Usar ícone padrão"

#: includes/admin/views/settings-page.php:248
msgid ""
"PNG, JPG, GIF, WebP, or SVG. Default plugin icon is used when none is "
"selected."
msgstr ""
"PNG, JPG, GIF, WebP ou SVG. O ícone padrão do plugin é usado quando nenhum é"
" selecionado."

#: includes/admin/views/settings-page.php:253
msgid "Icon size (px)"
msgstr "Tamanho do ícone (px)"

