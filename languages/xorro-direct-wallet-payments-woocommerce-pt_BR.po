msgstr "Chave da API CoinGecko (opcional)"

#. translators: %s: URL
#: includes/admin/views/settings-page.php:487
#, php-format
msgid ""
"Fiat↔crypto rates. Free without a key. Demo keys (CG-…) use the public API; "
"Pro keys use the Pro API. Get a key at %s"
msgstr ""
"Taxas de criptografia Fiat↔. Livre sem chave. Chaves de demonstração "
"(CG-...) usam a API pública; chaves Pro usam a API Pro. Pegue uma chave em "
"%s"

#: includes/admin/views/settings-page.php:503
msgid "Etherscan API V2 key"
