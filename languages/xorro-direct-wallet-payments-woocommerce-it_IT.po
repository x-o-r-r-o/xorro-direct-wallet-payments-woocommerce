#. Description of the plugin
#: xorro-direct-wallet-payments-woocommerce.php
msgid "Accept cryptocurrency payments directly to your own wallets — no third-party payment processor. Supports BTC, BCH, ETH, USDT, USDC, DAI, TON, ADA, APT, KAS, XTZ and 200+ coins/tokens with automatic on-chain verification."
msgstr "Accetta pagamenti criptovaluta direttamente ai tuoi portafogli — nessun processore di pagamento di terze parti. Supporta BTC, BCH, ETH, USDT, USDC, DAI, TON, ADA, APT, KAS, XTZ e 200+ monete / gettoni con verifica automatica on-chain."

#. Author of the plugin
#: xorro-direct-wallet-payments-woocommerce.php
msgid "xorro"
msgstr "xorro"

#. Author URI of the plugin
#: xorro-direct-wallet-payments-woocommerce.php
