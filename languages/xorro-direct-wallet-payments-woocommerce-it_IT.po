"Sent to the store owner when a crypto payment is short, over the amount due,"
" or arrives after the payment window closed."
msgstr ""
"Inviato al proprietario del negozio quando un pagamento cripto è breve, "
"sopra l'importo dovuto, o arriva dopo la finestra di pagamento chiusa."

#: includes/emails/class-xdwp-email-payment-alert.php:47
msgid "[{site_title}] Order #{order_number}: {issue}"
msgstr "[{site_title}] Ordine #{order_number}: {issue}"

#: includes/emails/class-xdwp-email-payment-alert.php:65
msgid "partial payment received"
msgstr "pagamento parziale ricevuto"

#: includes/emails/class-xdwp-email-payment-alert.php:66
