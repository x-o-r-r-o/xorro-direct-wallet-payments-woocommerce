#, php-format
msgid "Partial crypto payment: received %1$s %2$s of %3$s %2$s. Waiting for the remaining %4$s %2$s (txid: %5$s). The payment window was restarted."
msgstr "Pagamento parziale del cripto: ha ricevuto %1$s %2$s di %3$s %2$s. In attesa del restante %4$s %2$s (txid: %5$s). La finestra di pagamento è stata riavviata."

