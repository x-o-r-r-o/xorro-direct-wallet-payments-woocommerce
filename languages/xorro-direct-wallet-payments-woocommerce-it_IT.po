#, php-format
msgid "Set via %s in wp-config.php"
msgstr ""

#: includes/class-xdwp-settings.php:117
msgid "Key saved — leave blank to keep, paste a new key, or enter - to clear"
msgstr "Chiave salvata — lasciare vuoto per mantenere, incollare una nuova chiave, o inserire - per cancellare"

#: includes/class-xdwp-updater.php:179
msgid "Accept cryptocurrency payments directly to your own wallets — updates are delivered from GitHub Releases."
msgstr "Accetti i pagamenti criptovaluta direttamente ai tuoi portafogli — gli aggiornamenti vengono consegnati da GitHub Releases."

#: includes/class-xdwp-updater.php:182
msgid "See GitHub Releases for changelog details."
msgstr "Vedere GitHub Rilascia per i dettagli del changelog."

#: includes/class-xdwp-updater.php:219
msgid "Refused plugin update: package host is not an allowlisted GitHub download host."
msgstr "Aggiornamento del plugin rinnovato: l'host del pacchetto non è un host di download GitHub lista dei permessi."

#: includes/class-xdwp-updater.php:244
msgid "Refused plugin update: release SHA-256 checksum is unavailable."
msgstr "Aggiornamento plugin rinnovato: rilascio SHA-256 checksum non è disponibile."

#: includes/class-xdwp-updater.php:253
msgid "Refused plugin update: ZIP SHA-256 does not match the GitHub release checksum."
msgstr "Aggiornamento plugin rinnovato: ZIP SHA-256 non corrisponde al checksum di rilascio GitHub."

#: includes/class-xdwp-updater.php:269
msgid "Refused plugin update: the release is not signed with the Xorro Wallet Payments release key."
msgstr "Aggiornamento plugin rinnovato: il rilascio non è firmato con la chiave di rilascio Xorro Wallet Payments."

