#. Plugin Name of the plugin
#: xorro-direct-wallet-payments-woocommerce.php
msgid "Xorro Direct Wallet Payments for WooCommerce"
msgstr "Xorro Portafoglio diretto Pagamenti per WooCommerce"

#. Plugin URI of the plugin
#: xorro-direct-wallet-payments-woocommerce.php
msgid "https://github.com/x-o-r-r-o/xorro-direct-wallet-payments-woocommerce"
msgstr "https://github.com/x-o-r-r-o/xorro-direct-wallet-payments-woocommerce"

#. Description of the plugin
#: xorro-direct-wallet-payments-woocommerce.php
msgid ""
"Accept cryptocurrency payments directly to your own wallets — no third-party"
" payment processor. Supports BTC, BCH, ETH, USDT, USDC, DAI, TON, ADA, APT, "
"KAS, XTZ and 200+ coins/tokens with automatic on-chain verification."
msgstr ""
"Accetta pagamenti criptovaluta direttamente ai tuoi portafogli — nessun "
"processore di pagamento di terze parti. Supporta BTC, BCH, ETH, USDT, USDC, "
"DAI, TON, ADA, APT, KAS, XTZ e 200+ monete / gettoni con verifica automatica"
" on-chain."

#. Author of the plugin
#: xorro-direct-wallet-payments-woocommerce.php
msgid "xorro"
msgstr "xorro"

