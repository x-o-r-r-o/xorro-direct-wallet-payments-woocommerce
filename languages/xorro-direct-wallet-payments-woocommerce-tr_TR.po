msgstr "Polkadot (DOT) otomatik hız limitlerini geliştirin. %s'te ücretsiz"

#: includes/admin/views/settings-page.php:599
msgid "ViewBlock API key (optional)"
msgstr "ViewBlock API anahtar (isteğenim)"

