#. translators: 1: host, 2: HTTP status code
#: includes/class-xdwp-selftest.php:361
#, php-format
msgid ""
"%1$s answered with HTTP %2$d. Payments in this coin may not be confirmed "
"automatically."
msgstr ""
"%1$s HTTP%2$d ile cevap verdi. Bu paradaki ödemeler otomatik olarak "
"doğrulanamaz."

#. translators: %s: host
#: includes/class-xdwp-selftest.php:374
#, php-format
