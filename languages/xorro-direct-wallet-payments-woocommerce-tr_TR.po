msgstr "Etherscan API V2 anahtar"

#. translators: %s: URL
#: includes/admin/views/settings-page.php:511
#, php-format
msgid ""
"One free key covers ETH, BNB, Polygon, Arbitrum, Optimism, Avalanche, "
"Fantom, Cronos, ETC and 50+ EVM chains. Get it at %s"
msgstr ""
"Bir ücretsiz anahtar ETH, BNB, Polygon, Arbitrum, Optimizm, Avalanche, "
"Fantom, Cronos, ETC ve 50+ EVM zincirlerini kapsar. %s'te alın"

#: includes/admin/views/settings-page.php:527
