msgstr "Erhaltener Betrag"

#: includes/class-xdwp-privacy.php:40
msgid "Partial payments received"
msgstr "Erhaltene Teilzahlungen"

#: includes/class-xdwp-privacy.php:41
msgid "Amount still due"
msgstr "Noch fälliger Betrag"

#: includes/class-xdwp-privacy.php:42
msgid "Partial payment transaction IDs"
msgstr "ID des Teilzahlungsvorgangs"

#: includes/class-xdwp-privacy.php:43
msgid "Overpaid amount"
msgstr "Zu viel gezahlter Betrag"

#: includes/class-xdwp-privacy.php:44
msgid "Late payment transaction ID"
msgstr "ID des Zahlungsdienstleisters"

#: includes/class-xdwp-privacy.php:45
msgid "Late payment amount"
msgstr "Betrag der verspäteten Zahlung"

#: includes/class-xdwp-privacy.php:47
