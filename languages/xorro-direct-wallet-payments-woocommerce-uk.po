msgstr "в %s сплачених замовлень"

#: includes/admin/views/payments-page.php:157
#: includes/admin/views/payments-page.php:181
#: includes/admin/views/payments-page.php:212
msgid "Typical wait"
msgstr "Типове очікування"

#: includes/admin/views/payments-page.php:158
