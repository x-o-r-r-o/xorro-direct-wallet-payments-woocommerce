msgstr "Про нас"

#: includes/admin/views/settings-page.php:64
msgid "Quoted crypto amount is valid for this duration. Default: 60."
msgstr "Цільова сума є дійсною для цієї тривалості. За замовчуванням: 60."

#: includes/admin/views/settings-page.php:73
msgid "Processing"
msgstr "Переробка"

#: includes/admin/views/settings-page.php:74
