<?xml version="1.0"?>
<ruleset name="Xorro Direct Wallet Payments">
	<description>WordPress coding standards for this plugin.</description>

	<file>.</file>
	<exclude-pattern>/releases/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>*/assets/js/qrcode.min.js</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="ps"/>

	<!-- Errors only: warnings here are mostly style opinions this plugin does not follow. -->
	<config name="minimum_supported_wp_version" value="6.9"/>
	<config name="testVersion" value="7.4-"/>

	<!--
		This runs on every push, so it checks the things that can actually hurt a store:
		unescaped output, missing nonces, unsafe SQL, untranslated or wrongly-domained
		strings, and PHP compatibility. The purely cosmetic families (array formatting,
		Yoda conditions, alignment, comment punctuation) are left out on purpose — they
		would bury real findings under hundreds of spacing notices.
	-->
	<rule ref="WordPress.Security">
		<!-- The test scripts run on the command line: their echo is a console line, not a page. -->
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.DB">
		<!-- Deliberate: raw SQL is how the atomic payment locks stay atomic. -->
		<exclude name="WordPress.DB.DirectDatabaseQuery"/>
		<exclude name="WordPress.DB.PreparedSQLPlaceholders"/>
	</rule>
	<rule ref="WordPress.CodeAnalysis"/>
	<rule ref="WordPress.PHP.NoSilencedErrors"/>
	<rule ref="WordPress.PHP.DevelopmentFunctions"/>
	<rule ref="WordPress.PHP.DiscouragedPHPFunctions"/>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array" value="xdwp,Xdwp"/>
		</properties>
		<!--
			Templates are included from inside a method, so their variables are local, not
			global — the sniff cannot see that. WooCommerce's own email hooks are fired by
			our email templates on purpose, exactly as WooCommerce's templates do.
		-->
		<exclude-pattern>*/templates/*</exclude-pattern>
		<exclude-pattern>*/includes/admin/views/*</exclude-pattern>
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>

	<rule ref="WordPress.WP.GlobalVariablesOverride">
		<exclude-pattern>*/templates/*</exclude-pattern>
		<exclude-pattern>*/includes/admin/views/*</exclude-pattern>
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>

	<rule ref="WordPress.WP.Capabilities">
		<properties>
			<!-- WooCommerce's own capability; the sniff only knows core ones. -->
			<property name="custom_capabilities" type="array" value="manage_woocommerce"/>
		</properties>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array" value="xorro-direct-wallet-payments-woocommerce"/>
		</properties>
	</rule>
</ruleset>
